# Environment Configuration
DEBUG=True
API_PREFIX=/api/v1

# SQLite (no server needed)
DATABASE_URL=sqlite:///./data/weather.db

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Grid
GRID_LAT_MIN=0.0
GRID_LAT_MAX=40.0
GRID_LON_MIN=60.0
GRID_LON_MAX=100.0
GRID_RESOLUTION=0.25

DEFAULT_LOOKBACK=30
GAMMA=1.5
EPSILON=1e-5
